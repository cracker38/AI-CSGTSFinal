# Optional: call the API directly (CORS must allow your Vite origin). Recommended if proxy shows “Network error”.
# VITE_API_BASE=http://127.0.0.1:8010/api/v1
#
# If VITE_API_BASE is unset, axios uses /api/v1 and Vite proxies here (Node only — must match uvicorn):
# API_PROXY_TARGET=http://127.0.0.1:8010
#
# Backend CORS_ORIGINS must list this dev origin (e.g. http://localhost:5173 or :5174 if Vite picks another port).
