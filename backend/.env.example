APP_NAME=AI-CSGTS
ENVIRONMENT=dev
API_V1_PREFIX=/api/v1

# IMPORTANT: replace in production
JWT_SECRET_KEY=CHANGE_ME_SUPER_SECRET
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+psycopg://aicsgts:aicsgts_password@localhost:5432/aicsgts

# Training: idle auto-pause for open learning sessions (seconds, minimum 120).
TRAINING_STALE_HEARTBEAT_SECONDS=1800

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default System Admin seed (created if missing)
DEFAULT_SYSTEM_ADMIN_EMAIL=it.elias38@gmail.com
DEFAULT_SYSTEM_ADMIN_PASSWORD=Shema@123

# SMTP for login OTP emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
SMTP_FROM_EMAIL=no-reply@aicsgts.local
# Optional HTTPS email provider (recommended for hosted environments where SMTP ports are blocked)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OTP_EXPIRE_MINUTES=10

# Login flow toggle (set false only when SMTP cannot be used in a deployment environment)
LOGIN_REQUIRE_OTP=true
