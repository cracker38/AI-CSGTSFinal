APP_NAME=AI-CSGTS
ENVIRONMENT=dev
API_V1_PREFIX=/api/v1

JWT_SECRET_KEY=CHANGE_ME_SUPER_SECRET
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite: fast local dev (avoids login hanging if Postgres is slow or misconfigured).
DATABASE_URL=sqlite:///./aicsgts_dev.db
# PostgreSQL (Windows service on 5432) — uncomment when DB is verified working:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/postgres

# Training attendance: seconds without heartbeat before auto-pause (min 120).
TRAINING_STALE_HEARTBEAT_SECONDS=3600

# CORS (include every origin your Vite dev server uses, e.g. 5173 vs 5174)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Default System Admin seed (created if missing)
DEFAULT_SYSTEM_ADMIN_EMAIL=it.elias38@gmail.com
DEFAULT_SYSTEM_ADMIN_PASSWORD=Shema@123

# SMTP for real OTP delivery (e.g. Gmail: use an App Password, not your normal login)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=urhe665@gmail.com
SMTP_PASSWORD=ivhvsfvofhbulwzh
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
SMTP_FROM_EMAIL=urhe665@gmail.com
OTP_EXPIRE_MINUTES=10

# Set false only for local dev without email (requires matching auth bypass when implemented).
LOGIN_REQUIRE_OTP=true

# Optional: HTTPS email provider (when SMTP ports are blocked)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
